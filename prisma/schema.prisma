  status       ReviewStatus     @default(PENDING)

  reviewer   User                  @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUser User?                 @relation("ReviewTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  provider   Provider?             @relation(fields: [providerId], references: [id], onDelete: SetNull)
  work       Work?                 @relation(fields: [workId], references: [id], onDelete: SetNull)
  project    CollaborationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order      ProjectOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, reviewerId])
  @@index([reviewerId])
  @@index([targetType])
  @@index([targetUserId])
  @@index([providerId])
  @@index([workId])
  @@index([projectId])
  @@index([status])
}

model CaseStudy {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  coverUrl     String?
  summary      String?
  content      String?
  workId       String?
  projectId    String?
  schoolId     String?
  teacherId    String?
  providerId   String?
  designerName String?
  resultNote   String?
  isFeatured   Boolean         @default(false)
  status       CaseStudyStatus @default(DRAFT)

  work     Work?                 @relation(fields: [workId], references: [id], onDelete: SetNull)
  project  CollaborationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  school   School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  teacher  Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  provider Provider?             @relation(fields: [providerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId])
  @@index([projectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([providerId])
  @@index([status])
  @@index([isFeatured])
}

model FabricRequest {
  id             String        @id @default(cuid())
  userId         String
  workId         String?
  category       String?
  desiredFeeling String[]
  colorDirection String?
  budgetRange    String?
  contact        String
  remark         String?
  status         RequestStatus @default(PENDING)
  adminNote      String?
  handledAt      DateTime?
  handledById    String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work? @relation(fields: [workId], references: [id], onDelete: SetNull)
  handledBy User? @relation("FabricRequestHandledBy", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workId])
  @@index([status])
}

model SampleRequest {
  id              String        @id @default(cuid())
  userId          String
  workId          String?
  garmentCategory String?
  hasPattern      Boolean       @default(false)
  hasFabric       Boolean       @default(false)
  needsFabricHelp Boolean       @default(false)
  budgetRange     String?
  quantity        Int?
  expectedDate    DateTime?
  contact         String
  remark          String?
  status          RequestStatus @default(PENDING)
  adminNote       String?
  handledAt       DateTime?
  handledById     String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work? @relation(fields: [workId], references: [id], onDelete: SetNull)
  handledBy User? @relation("SampleRequestHandledBy", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workId])
  @@index([status])
}

model CooperationRequest {
  id                String              @id @default(cuid())
  userId            String
  workId            String?
  providerId        String?
  fabricId          String?
  showcaseItemId    String?
  type              CooperationType
  requestType       ProviderInquiryType @default(GENERAL)
  contact           String
  contactPreference String?
  quantity          Int?
  expectedDate      DateTime?
  message           String?
  budgetRange       String?
  providerResponse  String?
  status            RequestStatus       @default(PENDING)
  adminNote         String?
  viewedAt          DateTime?
  respondedAt       DateTime?
  handledAt         DateTime?
  handledById       String?

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  work         Work?                     @relation(fields: [workId], references: [id], onDelete: SetNull)
  provider     Provider?                 @relation(fields: [providerId], references: [id], onDelete: SetNull)
  fabric       Fabric?                   @relation(fields: [fabricId], references: [id], onDelete: SetNull)
  showcaseItem ProviderShowcaseItem?     @relation(fields: [showcaseItemId], references: [id], onDelete: SetNull)
  handledBy    User?                     @relation("CooperationRequestHandledBy", fields: [handledById], references: [id])
  replies      CooperationRequestReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workId])
  @@index([providerId])
  @@index([fabricId])
  @@index([showcaseItemId])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model CooperationRequestReply {
  id         String  @id @default(cuid())
  inquiryId  String
  senderId   String
  senderRole String
  content    String
  isRead     Boolean @default(false)

  inquiry CooperationRequest @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User               @relation("CooperationRequestReplySender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inquiryId, createdAt])
  @@index([senderId])
  @@index([isRead])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus     @default(PENDING)
  result      String?
  adminNote   String?
  handledAt   DateTime?
  handledById String?

  reporter  User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("ReportHandledBy", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  content String
  isRead  Boolean          @default(false)
  linkUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
}

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id         String @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  detail     Json?

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([targetType, targetId])
}

enum CommercePaymentAttemptStatus {
  CREATED
  PROCESSING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum CommerceRefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CommerceIdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum CommerceAggregateType {
  CAMPAIGN
  ORDER
  PAYMENT
  REFUND
  FULFILLMENT
}

model CommercePaymentAttempt {
  id                String                       @id @default(cuid())
  orderId           String
  provider          String
  providerAttemptId String?
  idempotencyKey    String                       @unique
  amount            Int
  currency          String                       @default("CNY")
  status            CommercePaymentAttemptStatus @default(CREATED)
  failureCode       String?
  failureMessage    String?
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  order             ProjectOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           CommerceRefund[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([provider, providerAttemptId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model CommerceRefund {
  id               String                  @id @default(cuid())
  orderId          String
  paymentAttemptId String?
  provider         String
  providerRefundId String?
  idempotencyKey   String                  @unique
  amount           Int
  currency         String                  @default("CNY")
  status           CommerceRefundStatus    @default(REQUESTED)
  reason           String?
  failureCode      String?
  failureMessage   String?
  requestedAt      DateTime                @default(now())
  completedAt      DateTime?
  order            ProjectOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt   CommercePaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([provider, providerRefundId])
  @@index([orderId])
  @@index([paymentAttemptId])
  @@index([status])
  @@index([createdAt])
}

model CommerceIdempotencyRecord {
  id           String                    @id @default(cuid())
  scope        String
  key          String
  requestHash  String
  status       CommerceIdempotencyStatus @default(PROCESSING)
  responseCode Int?
  responseBody Json?
  lockedAt     DateTime                  @default(now())
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([scope, key])
  @@index([status])
  @@index([expiresAt])
}

model CommerceStateEvent {
  id             String                @id @default(cuid())
  aggregateType  CommerceAggregateType
  aggregateId    String
  fromState      String?
  toState        String
  actorId        String?
  reason         String?
  metadata       Json?
  idempotencyKey String?
  createdAt      DateTime              @default(now())

  @@unique([aggregateType, aggregateId, idempotencyKey])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}
